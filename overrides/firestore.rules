rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verifiedUser() { return request.auth != null && request.auth.token.email_verified == true; }
    function isAdmin() { return verifiedUser() && request.auth.uid == 'Cva1DdKPU3QIVXOoA3kSJG0DYxw1'; }
    match /users/{userId} {
      allow read: if verifiedUser() && (isAdmin() || request.auth.uid == userId || resource.data.suspended != true);
      allow create: if verifiedUser() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid','displayName','photoUrl','bio','favoriteSounds','totalListeningMs','totalPlays','createdAt','lastActiveAt'])
        && request.resource.data.uid == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2 && request.resource.data.displayName.size() <= 30
        && request.resource.data.photoUrl == '' && request.resource.data.bio == '' && request.resource.data.favoriteSounds == ''
        && request.resource.data.totalListeningMs == 0 && request.resource.data.totalPlays == 0;
      allow update: if verifiedUser() && (
        (isAdmin() && userId != 'Cva1DdKPU3QIVXOoA3kSJG0DYxw1' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['suspended']) && request.resource.data.suspended is bool)
        ||
        (request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','photoUrl','bio','favoriteSounds','totalListeningMs','totalPlays','lastActiveAt'])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() >= 2 && request.resource.data.displayName.size() <= 30
          && request.resource.data.photoUrl is string && request.resource.data.photoUrl.size() <= 500
          && (request.resource.data.photoUrl == '' || request.resource.data.photoUrl.matches('https://.*'))
          && request.resource.data.bio is string && request.resource.data.bio.size() <= 160
          && request.resource.data.favoriteSounds is string && request.resource.data.favoriteSounds.size() <= 500
          && request.resource.data.totalListeningMs >= resource.data.totalListeningMs
          && request.resource.data.totalListeningMs <= resource.data.totalListeningMs + 120000
          && request.resource.data.totalPlays >= resource.data.totalPlays
          && request.resource.data.totalPlays <= resource.data.totalPlays + 1)
      );
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}