rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.uid == 'Cva1DdKPU3QIVXOoA3kSJG0DYxw1'; }
    function areFriends(a, b) {
      return exists(/databases/$(database)/documents/users/$(a)/friends/$(b));
    }

    match /users/{userId} {
      // Community profiles are readable by signed-in members; suspended profiles are hidden
      // from other members, while the owner and admin can still inspect their own records.
      allow read: if signedIn(); // Profiles expose only public community fields; the UI filters suspended accounts.

      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid','displayName','photoUrl','bio','favoriteSounds','photoData','totalListeningMs','totalPlays','createdAt','lastActiveAt'])
        && request.resource.data.uid == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 30
        && request.resource.data.photoUrl == ''
        && request.resource.data.photoData == ''
        && request.resource.data.bio == ''
        && request.resource.data.favoriteSounds == ''
        && request.resource.data.totalListeningMs == 0
        && request.resource.data.totalPlays == 0;

      allow update: if signedIn() && (
        (isAdmin()
          && userId != 'Cva1DdKPU3QIVXOoA3kSJG0DYxw1'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['suspended'])
          && request.resource.data.suspended is bool)
        ||
        (request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','photoUrl','photoData','bio','favoriteSounds','totalListeningMs','totalPlays','lastActiveAt'])
          && request.resource.data.get('displayName', '') is string
          && request.resource.data.get('displayName', '').size() >= 2
          && request.resource.data.get('displayName', '').size() <= 30
          && request.resource.data.get('photoData', '') is string
          && request.resource.data.get('photoData', '').size() <= 180000
          && request.resource.data.get('photoUrl', '') is string
          && request.resource.data.get('photoUrl', '').size() <= 500
          && (request.resource.data.get('photoUrl', '') == '' || request.resource.data.get('photoUrl', '').matches('https://.*'))
          && request.resource.data.get('bio', '') is string
          && request.resource.data.get('bio', '').size() <= 160
          && request.resource.data.get('favoriteSounds', '') is string
          && request.resource.data.get('favoriteSounds', '').size() <= 500
          && request.resource.data.get('totalListeningMs', 0) is int
          && request.resource.data.get('totalListeningMs', 0) >= resource.data.get('totalListeningMs', 0)
          && request.resource.data.get('totalListeningMs', 0) <= resource.data.get('totalListeningMs', 0) + 120000
          && request.resource.data.get('totalPlays', 0) is int
          && request.resource.data.get('totalPlays', 0) >= resource.data.get('totalPlays', 0)
          && request.resource.data.get('totalPlays', 0) <= resource.data.get('totalPlays', 0) + 1)
      );

      match /following/{targetUid} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn() && request.auth.uid == userId && targetUid != userId
          && request.resource.data.targetUid == targetUid;
        allow update: if signedIn() && request.auth.uid == userId
          && request.resource.data.targetUid == targetUid;
        allow delete: if signedIn() && request.auth.uid == userId;
      }
      match /followers/{followerUid} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn() && request.auth.uid == followerUid && followerUid != userId
          && request.resource.data.uid == followerUid;
        allow update: if signedIn() && request.auth.uid == followerUid
          && request.resource.data.uid == followerUid;
        allow delete: if signedIn() && request.auth.uid == followerUid;
      }
      match /friendRequests/{requesterUid} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn() && request.auth.uid == requesterUid && requesterUid != userId
          && request.resource.data.requesterUid == requesterUid
          && request.resource.data.recipientUid == userId
          && request.resource.data.status == 'pending';
        allow update: if signedIn() && (
          (request.auth.uid == userId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','respondedAt'])
            && request.resource.data.status in ['accepted','rejected'])
          || (request.auth.uid == requesterUid && resource.data.status == 'rejected'
            && request.resource.data.requesterUid == requesterUid
            && request.resource.data.recipientUid == userId
            && request.resource.data.status == 'pending')
        );
        allow delete: if signedIn() && (request.auth.uid == userId || request.auth.uid == requesterUid);
      }
      match /sentFriendRequests/{targetUid} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn() && request.auth.uid == userId && targetUid != userId
          && request.resource.data.requesterUid == userId
          && request.resource.data.recipientUid == targetUid
          && request.resource.data.status == 'pending';
        allow update: if signedIn() && (
          (request.auth.uid == targetUid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','respondedAt'])
            && request.resource.data.status in ['accepted','rejected'])
          || (request.auth.uid == userId && resource.data.status == 'rejected'
            && request.resource.data.requesterUid == userId
            && request.resource.data.recipientUid == targetUid
            && request.resource.data.status == 'pending')
        );
        allow delete: if signedIn() && request.auth.uid == userId;
      }
      match /friends/{friendUid} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn() && (request.auth.uid == userId || request.auth.uid == friendUid)
          && request.resource.data.uid == friendUid;
        allow update: if signedIn() && (request.auth.uid == userId || request.auth.uid == friendUid)
          && request.resource.data.uid == friendUid;
        allow delete: if signedIn() && (request.auth.uid == userId || request.auth.uid == friendUid);
      }
      allow delete: if false;
    }


    match /communityPosts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 60
        && request.resource.data.kind in ['قصيدة','اقتباس','منشور']
        && request.resource.data.body is string && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 5000;
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body'])
        && request.resource.data.body is string && request.resource.data.body.size() <= 5000;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /chatRequests/{requestId} {
      allow create: if signedIn() && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid != request.auth.uid
        && areFriends(request.auth.uid, request.resource.data.targetUid)
        && request.resource.data.status == 'pending';
      allow read: if isAdmin() || (signedIn() &&
        (resource.data.requesterUid == request.auth.uid || resource.data.targetUid == request.auth.uid));
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedAt','threadId'])
        && request.resource.data.status in ['approved','rejected'];
      allow delete: if isAdmin();
    }

    match /chatThreads/{threadId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create, update, delete: if isAdmin();
      match /messages/{messageId} {
        function threadData() {
          return get(/databases/$(database)/documents/chatThreads/$(threadId)).data;
        }
        allow read: if signedIn() && request.auth.uid in threadData().participants;
        allow create: if signedIn() && request.auth.uid in threadData().participants
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 2000;
        allow update, delete: if false;
      }
    }

    match /articles/{articleId} {
      allow read: if signedIn() && (resource.data.status == 'published' || resource.data.authorUid == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['title','subtitle','body','coverUrl','authorUid','authorName','status','createdAt','updatedAt','publishedAt','bodyFontSize','bodyBold','bodyAlign','bodyColor'])
        && request.resource.data.title is string && request.resource.data.title.size() >= 3 && request.resource.data.title.size() <= 120
        && request.resource.data.subtitle is string && request.resource.data.subtitle.size() <= 220
        && request.resource.data.body is string && request.resource.data.body.size() >= 1 && request.resource.data.body.size() <= 30000
        && request.resource.data.coverUrl is string && request.resource.data.coverUrl.size() <= 1000
        && (request.resource.data.coverUrl == '' || request.resource.data.coverUrl.matches('https://.*'))
        && request.resource.data.status in ['draft','published']
        && request.resource.data.get('bodyColor', '#222222') is string
        && request.resource.data.get('bodyColor', '#222222').size() <= 7;
      allow update: if signedIn() && (resource.data.authorUid == request.auth.uid || isAdmin())
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','subtitle','body','coverUrl','authorName','status','updatedAt','publishedAt','bodyFontSize','bodyBold','bodyAlign'])
        && request.resource.data.title is string && request.resource.data.title.size() >= 3 && request.resource.data.title.size() <= 120
        && request.resource.data.subtitle is string && request.resource.data.subtitle.size() <= 220
        && request.resource.data.body is string && request.resource.data.body.size() <= 30000
        && request.resource.data.coverUrl is string && request.resource.data.coverUrl.size() <= 1000
        && (request.resource.data.coverUrl == '' || request.resource.data.coverUrl.matches('https://.*'))
        && request.resource.data.status in ['draft','published'];
      allow delete: if signedIn() && (resource.data.authorUid == request.auth.uid || isAdmin());
      match /comments/{commentId} {
        allow read: if signedIn() && get(/databases/$(database)/documents/articles/$(articleId)).data.status == 'published';
        allow create: if signedIn()
          && get(/databases/$(database)/documents/articles/$(articleId)).data.status == 'published'
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() <= 60
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 2000;
        allow update, delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}