rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function threadMember(threadId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/chatThreads/$(threadId))
        && request.auth.uid in firestore.get(/databases/(default)/documents/chatThreads/$(threadId)).data.participants;
    }

    match /Whisper-Player/ProfilePhotos/{uid}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /Whisper-Player/Covers/{uid}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /Whisper-Player/Articles/{uid}/Audio/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.size < 30 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
    }
    match /Whisper-Player/ArticleComments/{articleId}/{uid}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.size < 30 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
    }
    match /Whisper-Player/Chat/{uid}/{threadId}/{fileName} {
      allow read: if threadMember(threadId);
      allow write: if threadMember(threadId) && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /Whisper-Player/Voice/{uid}/{threadId}/{fileName} {
      allow read: if threadMember(threadId);
      allow write: if threadMember(threadId) && request.auth.uid == uid
        && request.resource.size < 30 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
